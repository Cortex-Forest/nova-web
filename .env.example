# ============================================================================
# YAZIMAO（鸭子毛）Web 环境变量示例 —— 复制为 .env.local 并填写真实值
# 所有 NEXT_PUBLIC_* 前缀的变量会被暴露到浏览器，切勿放入密钥。
# ============================================================================

# --- 正式站点域名（生产）---
# 生产域名：https://yazimao.xyz —— 示例值。部署后在 Vercel 环境变量中设置 NEXT_PUBLIC_SITE_URL=https://yazimao.xyz。
# 旧域名 nova-super.xyz 不立即废弃：将在 Vercel 层通过 301 Redirect 迁移到 https://yazimao.xyz。
# 本文件只配置 URL（canonical/OG/sitemap）；是否允许被索引由 VERCEL_ENV 环境判定（见 app/robots.ts）
NEXT_PUBLIC_SITE_URL=https://yazimao.xyz

# --- Explorer / Indexer API（预留，未上线前保持为空，页面显示 Coming Soon）---
NEXT_PUBLIC_EXPLORER_API_URL=

# --- Public RPC（预留）---
NEXT_PUBLIC_RPC_URL=

# --- Analytics（预留）---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Early Access 注册存储 ---
# 主存储（推荐）：Supabase PostgreSQL（server-only，绝不使用 NEXT_PUBLIC_ 前缀）。
# 二者均配置时，POST /api/early-access 写入 early_access_applications；
# 均未配置时接口返回 503 REGISTRATION_NOT_AVAILABLE（诚实降级，绝不假装已注册）。
SUPABASE_URL=
# Server-only secret. Never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Early Access legacy/alternative HTTP endpoint（可选，仅当未用 Supabase 时）---
# 主存储 Supabase 未配置时才考虑此 HTTP adapter；二者都配置时以 Supabase 为准（无双重写入）。
EARLY_ACCESS_ENDPOINT=

# --- 网络/进度标签（默认：Protocol Development，诚实反映尚未上线主网/公共测试网）---
# 若环境未设置，代码默认值为 Protocol Development；禁止设置为 "Mainnet"。
NEXT_PUBLIC_NETWORK_LABEL=Protocol Development
